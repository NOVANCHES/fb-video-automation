# Clave de API de Google Gemini (Consíguela gratis en https://aistudio.google.com/apikey)
GEMINI_API_KEY=tu_api_key_de_gemini_aqui

# Voz de Edge-TTS (Ejemplos: es-MX-JorgeNeural, es-MX-DaliaNeural, es-ES-AlvaroNeural)
TTS_VOICE=es-MX-JorgeNeural

# Modelo de Whisper (tiny, base, small, medium, large)
WHISPER_MODEL=base

# Credenciales de Facebook para automatización con Selenium
FB_EMAIL=Voircréerpartager
FB_PASSWORD=tu_password_aqui
FB_PAGE_NAME=ERPA VARDE
